{
  "name": "omochat",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack": "npm run build && evenhub pack app.json dist -o omochat.ehpk",
    "test": "vitest run"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.13",
    "@evenrealities/pretext": "^0.1.4"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.12",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
