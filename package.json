{
  "name": "omochat",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack": "npm run build && evenhub pack app.json dist -o omochat.ehpk",
    "test": "vitest run",
    "verify:l0": "npm run typecheck && npm test",
    "test:omoserv": "cd companion/android && ./gradlew testDebugUnitTest --no-daemon",
    "sim": "evenhub-simulator http://localhost:5173",
    "sim:auto": "evenhub-simulator \"http://127.0.0.1:5173/?companionProbe=0\" --automation-port 9898",
    "verify:l2a": "even-deskless verify-l2a",
    "verify:deskless": "npm run verify:l0 && npm run test:omoserv && npm run verify:l2a"
  },
  "evenDeskless": {
    "readyMarker": "[omochat] ready",
    "appUrl": "http://127.0.0.1:5173/?companionProbe=0"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.14",
    "@evenrealities/pretext": "^0.1.4"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "0.1.14",
    "@evenrealities/evenhub-simulator": "^0.9.3",
    "@penta2himajin/even-deskless": "^0.1.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
